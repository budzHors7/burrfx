{
  "name": "desktop-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:sidecar": "powershell -ExecutionPolicy Bypass -File ../scripts/build-python-sidecar.ps1",
